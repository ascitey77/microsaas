# ═══════════════════════════════════════════════════════════════
# VitrineLab — Variables d'environnement
# Copier vers .env.local et remplir les valeurs
# ═══════════════════════════════════════════════════════════════

# ——— App (public) ———
# URL canonique de l'app SaaS (sans slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domaine racine pour sous-domaines clients : {slug}.vitrinelab.com
NEXT_PUBLIC_APP_DOMAIN=vitrinelab.com

# ——— Supabase ———
# Dashboard Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ JAMAIS exposer côté client — serveur / webhooks uniquement
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ——— Stripe ———
# Dashboard Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...

# Webhook : Stripe CLI → stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (Products → chaque plan → Price ID)
STRIPE_PRICE_STARTER=price_xxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxx
STRIPE_PRICE_AGENCY=price_xxxxxxxx

# ——— Resend (emails dunning paiement échoué) ———
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=VitrineLab <billing@vitrinelab.com>

# ——— Upstash Redis (rate limiting /api/*) ———
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxx

# ——— Claude API (Phase 2 — pré-remplissage IA onboarding) ———
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ——— Vercel (optionnel en local) ———
# VERCEL_URL est injecté automatiquement sur Vercel
